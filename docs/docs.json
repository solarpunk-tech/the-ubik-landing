  },
  "fonts": {
    "heading": {
      "family": "Noto Sans",
      "weight": 600
    },
    "body": {
      "family": "Noto Sans",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FBFAF7",
      "dark": "#0B1220"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "Main site",
        "href": "https://theubik.com"
      },
      {
        "label": "Talk to founders",
        "href": "https://calendar.app.google/frJjo2U6qdBdgZ1w9"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.theubik.com"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Main site",
            "href": "https://theubik.com"
          },
          {
            "label": "Pricing",
            "href": "https://theubik.com/pricing"
          },
          {
            "label": "Security",
            "href": "https://theubik.com/security"
          }
        ]
      },
      {
        "header": "Legal",
