{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "ubik guide",
  "description": "Run Ask ubik, Inbox, Tasks, and reviewed trade workflows.",
  "logo": {
    "light": "/images/ubik-wordmark-light.png",
    "dark": "/images/ubik-wordmark-dark.png",
    "href": "https://theubik.com"
  },
  "favicon": {
    "light": "/images/favicon-light.png",
    "dark": "/images/favicon-dark.png"
  },
  "colors": {
    "primary": "#315CF4",
    "light": "#5B82FF",
    "dark": "#315CF4"
  },
  "appearance": {
    "default": "system",
