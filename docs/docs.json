          {
            "label": "Privacy",
            "href": "https://theubik.com/legal/privacy"
          },
          {
            "label": "Subprocessors",
            "href": "https://theubik.com/legal/subprocessors"
          },
          {
            "label": "Cookies",
            "href": "https://theubik.com/legal/cookies"
          },
          {
            "label": "Terms",
            "href": "https://theubik.com/terms-of-service"
          }
        ]
      }
    ],
    "socials": {
      "website": "https://theubik.com",
      "linkedin": "https://www.linkedin.com/company/solarpunk-tech"
    }
