{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/downloads/(.*)\\.exe",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    },
    {
      "source": "/downloads/(.*)\\.dmg",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-diskimage" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ],
  "redirects": [
    { "source": "/terms", "destination": "/terms-of-service", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/guide", "destination": "https://docs.theubik.com", "permanent": false },
    { "source": "/try", "destination": "https://app.theubik.com", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
